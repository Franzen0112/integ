{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "JJRK Studio (Chrome + localhost)",
      "url": "http://127.0.0.1:8080/dashboard.html",
      "webRoot": "${workspaceFolder}",
